<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Decoración superior izquierda -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/decoration_light" />

    <!-- Decoración inferior derecha -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-130dp"
        android:layout_marginBottom="-130dp"
        android:background="@drawable/decoration_light" />

    <!-- Contenido principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp"
        android:paddingTop="65dp"
        android:paddingBottom="40dp">

        <!-- Logo sencillo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎬"
            android:textSize="64sp"
            android:layout_marginBottom="5dp" />

        <!-- Nombre de la app -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MovieReviews"
            android:textColor="@color/navy"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Eslogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCOVER  ·  REVIEW  ·  SHARE"
            android:textColor="@color/blue_dark"
            android:textSize="12sp"
            android:letterSpacing="0.15"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="55dp" />

        <!-- Member Login -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Member Login"
            android:textColor="@color/navy"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in to continue"
            android:textColor="@color/blue_dark"
            android:textSize="16sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp" />

        <!-- Usuario -->
        <EditText
            android:id="@+id/usernameInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/input_background"
            android:hint="Usuario"
            android:textColor="@color/navy"
            android:textColorHint="@color/blue_dark"
            android:textSize="16sp"
            android:singleLine="true"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:inputType="text"
            android:layout_marginBottom="15dp" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/input_background"
            android:hint="Contraseña"
            android:textColor="@color/navy"
            android:textColorHint="@color/blue_dark"
            android:textSize="16sp"
            android:singleLine="true"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp" />

        <!-- Iniciar sesión -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/button_background"
            android:backgroundTint="@null"
            android:text="SIGN IN"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp" />

        <!-- Aquí siguen apareciendo los errores del login -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/error_red"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="15dp" />

        <!-- Texto inferior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MovieReviews"
            android:textColor="@color/blue_dark"
            android:textSize="13sp"
            android:layout_marginTop="25dp" />

    </LinearLayout>

</FrameLayout>