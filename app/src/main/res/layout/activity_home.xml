<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingLeft="28dp"
    android:paddingRight="28dp"
    android:paddingTop="35dp"
    android:paddingBottom="20dp">

    <!-- Nombre de la aplicación -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MercadoPreso"
        android:textColor="@color/navy"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Panel -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ADMINISTRATOR PANEL"
        android:textColor="@color/blue_dark"
        android:textSize="12sp"
        android:letterSpacing="0.15"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="20dp" />

    <!-- Bienvenida -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido"
        android:textColor="@color/navy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="18dp" />

    <!-- Tarjeta Fake Store API -->
    <LinearLayout
        android:id="@+id/apiCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_card_background"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fake Store API"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/apiStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/status_background"
            android:text="●  Conectado"
            android:textColor="@color/navy"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

    </LinearLayout>

    <!-- Tarjeta de cuenta -->
    <LinearLayout
        android:id="@+id/accountCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/admin_card_background"
        android:orientation="vertical"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Información de la cuenta"
            android:textColor="@color/navy"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/usernameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario"
            android:textColor="@color/navy"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/passwordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="••••••••"
            android:textColor="@color/navy"
            android:textSize="15sp"
            android:layout_marginTop="5dp" />

        <TextView
            android:id="@+id/roleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Administrador"
            android:textColor="@color/blue_dark"
            android:textSize="14sp"
            android:layout_marginTop="5dp" />

    </LinearLayout>

    <!-- Título catálogo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CATÁLOGO DE PRODUCTOS"
        android:textColor="@color/navy"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- Mensaje de error -->
    <TextView
        android:id="@+id/catalogErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No se pudo cargar el catálogo"
        android:textColor="@color/blue_dark"
        android:textSize="15sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <!-- Reintentar -->
    <Button
        android:id="@+id/retryButton"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_gravity="center"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="REINTENTAR"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <!-- Catálogo -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/productsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

    <!-- Cerrar sesión -->
    <Button
        android:id="@+id/logoutButton"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="CERRAR SESIÓN"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

</LinearLayout>