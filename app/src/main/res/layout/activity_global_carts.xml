<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/globalCartsBackButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="REGRESAR"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="12dp"
        android:text="HISTÓRICO GLOBAL DE CARRITOS"
        android:textColor="@color/navy"
        android:textSize="21sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/globalCartsLoadingProgress"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/globalCartsErrorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@color/error_red"
        android:visibility="gone" />

    <Button
        android:id="@+id/globalCartsRetryButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/button_background"
        android:backgroundTint="@null"
        android:text="REINTENTAR"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/globalCartsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />
</LinearLayout>
